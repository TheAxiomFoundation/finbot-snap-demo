# OpenAI key for the chat layer.
OPENAI_API_KEY=sk-...

# Production: URL of the Modal-hosted axiom-engine service (see modal_app.py).
# When set, the chat tools call it over HTTP. When unset, the runtime spawns
# the local Rust binary against the local compiled artifact (dev path).
# Example after `modal deploy modal_app.py`:
#   https://policyengine--axiom-engine-web.modal.run
AXIOM_ENGINE_URL=

# Local dev only — paths to the binary and artifacts produced by
# `bun run engine:setup`. Defaults usually work; only override if you put the
# axiom repos somewhere else.
AXIOM_RULES_BINARY=
AXIOM_ARTIFACTS_DIR=
